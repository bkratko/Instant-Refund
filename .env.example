# --- API / worker ---
DATABASE_URL=postgresql://user:password@host:25060/instant_refund?sslmode=require
API_KEYS=key1,key2
SIGNER_SHARED_SECRET=
SIGNER_URL=http://instant-refund-signer:8080
CORS_ORIGINS=https://yourdomain.com
RATE_LIMIT=60/minute

# --- Kaspa ---
KASPA_NETWORK=mainnet
KASPAD_ADDRESS=your-kaspad-host
KASPA_REFUND_FROM_ADDRESS=kaspa:...
KASPA_FEE_ATOMIC=1000
SETTLEMENT_PROVIDER=kaspa            # kaspa | kaspa_hosted
KASPA_HOSTED_BASE_URL=
KASPA_HOSTED_API_KEY=
KASPA_CONFIRMATIONS_REQUIRED=1

# --- Rust sidecar ---
KASPA_SETTLEMENT_PRIVKEY_FILE=/run/secrets/kaspa_settlement_key
KASPA_EXPECTED_FROM_ADDRESS=kaspa:...
SIDECAR_HTTP_HOST=0.0.0.0
SIDECAR_HTTP_PORT=8080
