# Copy to .env (scripts/bootstrap.sh generates one for you). Never commit .env.
KASPA_NETWORK=testnet-10
KASPA_EXPECTED_FROM_ADDRESS=        # printed by scripts/keygen.sh
KASPA_CONFIRMATIONS_REQUIRED=10
POSTGRES_PASSWORD=
SIGNER_SHARED_SECRET=               # 48+ random chars
API_KEYS=                           # comma-separated client keys
CORS_ORIGINS=
RATE_LIMIT=300/minute
